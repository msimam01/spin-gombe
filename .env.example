# |--------------------------------------------------------------------------
# | SPIN Project Gombe — local development template
# |--------------------------------------------------------------------------
# | Copy to .env for local development. The companion production template
# | is .env.production.example; the deployment walkthrough is
# | docs/deployment-cpanel.md.
# |--------------------------------------------------------------------------

APP_NAME="SPIN Project Gombe"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Production runs on MySQL provisioned in cPanel → MySQL Databases:
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=cpaneluser_databasename
# DB_USERNAME=cpaneluser_dbuser
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=180
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true when serving over https so cookies are never sent over http.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Document-root image directory (App\Support\CoverImage public_web disk).
# Local dev: leave both unset or commented (images fall back to the public
# disk, exactly like before). The two settings are independent:
#   PUBLIC_IMAGES_PATH - optional ABSOLUTE filesystem root (production only,
#                        needed when the app's public/ is not the web root).
#   PUBLIC_IMAGES_DIR  - URL segment (public URLs become /images/...), and
#                        the local fallback root under public_path().
# See docs/deployment-cpanel.md (Step 5b).
# PUBLIC_IMAGES_DIR=images
# PUBLIC_IMAGES_PATH=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis is unavailable on shared hosting; production uses the
# database-backed session/cache/queue defaults above.
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Reverse proxy (production): cPanel terminates TLS behind a local proxy.
# Set TRUSTED_PROXIES=* on the server so Laravel detects https and the
# real host name. Leave unset locally. See config/trustedproxy.php.
# TRUSTED_PROXIES=*

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
