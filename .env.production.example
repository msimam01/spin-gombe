# |--------------------------------------------------------------------------
# | SPIN Project Gombe — production environment template (cPanel / WhoGoHost)
# |--------------------------------------------------------------------------
# | Copy to .env on the server, then replace every value marked < REQUIRED >.
# | Nothing below contains real credentials — this file is safe to commit.
# |
# | Full walkthrough: docs/deployment-cpanel.md
# |--------------------------------------------------------------------------

APP_NAME="SPIN Project Gombe"
APP_ENV=production
# Generate on the server: php artisan key:generate --force  (or locally:
# php artisan key:generate --show, then paste the output here).
APP_KEY=<REQUIRED: base64 key from artisan key:generate>
# Never enable debug on a public server: it leaks configuration and
# stack traces to visitors.
APP_DEBUG=false
# Canonical public URL, including https. Every generated link, the
# storage URL and e-mailed reset links derive from this.
APP_URL=<REQUIRED: https://your-domain.tld>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
# daily logs keep the last N days (cPanel disk quotas are finite).
LOG_DAILY_DAYS=14
LOG_LEVEL=error

# |--------------------------------------------------------------------------
# | Database — create the DB and user in cPanel → MySQL Databases, then
# | fill these in. Host is almost always "localhost" on cPanel.
# |--------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<REQUIRED: cpaneluser_databasename>
DB_USERNAME=<REQUIRED: cpaneluser_dbuser>
DB_PASSWORD=<REQUIRED>

# |--------------------------------------------------------------------------
# | Sessions / cache / queue — all database-backed (no Redis on shared
# | hosting). The tables are created by the migrations.
# |--------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true once the site is served over https (see APP_URL).
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# |--------------------------------------------------------------------------
# | Managed images (App\Support\CoverImage public_web disk)
# |--------------------------------------------------------------------------
# | THIS deployment uses two separate directories: the Laravel application
# | lives in /home/spingomb/spin-app (its public/ is NOT the web root) and
# | the domain document root is /home/spingomb/domains/spingombe.com.ng/
# | public_html. Apache serves the document root directly, so the images
# | directory must exist THERE - not under spin-app/public - and be
# | writable by the PHP application (cPanel default 0755 with the account
# | owner is normally sufficient).
# |
# |   PUBLIC_IMAGES_PATH - ABSOLUTE filesystem root of that directory.
# |   PUBLIC_IMAGES_DIR  - URL segment; public URLs become /images/...
# |
# | Both lines are required on this hosting account. The absolute path is
# | intentionally environment configuration, never hardcoded in code.
# | See docs/deployment-cpanel.md (Step 5b).
# |--------------------------------------------------------------------------
PUBLIC_IMAGES_DIR=images
PUBLIC_IMAGES_PATH=/home/spingomb/domains/spingombe.com.ng/public_html/images

# |--------------------------------------------------------------------------
# | Reverse proxy — cPanel serves the site behind a local proxy that
# | terminates TLS. Trusting its X-Forwarded-* headers is what makes
# | Laravel see https and the real host.
# |
# | "*" trusts the directly connected client — the standard cPanel setup,
# | but NOT universally safe: it assumes every request really arrives
# | through that local proxy. Confirm the topology (e.g. with the host's
# | support) before shipping; do not blindly copy it to any other host.
# | Where the proxy's addresses are known, an explicit allow-list is
# | safer: TRUSTED_PROXIES=a.b.c.d/32,10.0.0.0/8
# | Unset = trust nothing (direct connection).
# |--------------------------------------------------------------------------
TRUSTED_PROXIES=*

# |--------------------------------------------------------------------------
# | Mail — use the domain's own cPanel e-mail account
# | (Email Accounts → create e.g. info@your-domain.tld). The SMTP host is
# | mail.your-domain.tld, port 465 (SSL) or 587 (STARTTLS).
# |--------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=<REQUIRED: mail.your-domain.tld>
MAIL_PORT=465
MAIL_USERNAME=<REQUIRED: info@your-domain.tld>
MAIL_PASSWORD=<REQUIRED>
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=<REQUIRED: info@your-domain.tld>
MAIL_FROM_NAME="${APP_NAME}"

# |--------------------------------------------------------------------------
# | Initial administrator account (used only the first time the seeder
# | runs — the password is never re-synced from .env afterwards).
# | Log in at https://your-domain.tld/admin with these credentials.
# |--------------------------------------------------------------------------
ADMIN_NAME="SPIN Administrator"
ADMIN_EMAIL=<REQUIRED: login e-mail for /admin>
ADMIN_PASSWORD=<REQUIRED: choose a strong password>

VITE_APP_NAME="${APP_NAME}"
